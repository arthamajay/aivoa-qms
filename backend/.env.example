# Groq API Configuration (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=gemma2-9b-it

# Database Configuration (Supports PostgreSQL or MySQL)
# PostgreSQL example:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aivoa_qms
# MySQL example:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/aivoa_qms

# Server Configuration
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
